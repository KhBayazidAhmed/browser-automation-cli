{
	"name": "browser-automation-cli",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"cli": "bun apps/tui/src/index.ts",
		"flow": "bun apps/tui/src/index.ts flow",
		"record": "bun apps/tui/src/index.ts record",
		"task": "bun apps/tui/src/index.ts task",
		"tasks": "bun apps/tui/src/index.ts tasks",
		"repl": "bun apps/tui/src/index.ts repl",
		"cleanup": "bun apps/tui/src/index.ts cleanup",
		"test": "bun test apps/tui/tests",
		"test:watch": "bun test --watch apps/tui/tests",
		"test:headed": "HEADED=1 bun test apps/tui/tests",
		"test:strict": "bun test apps/tui/tests/locators.test.ts apps/tui/tests/assertions.test.ts",
		"test:flows": "bun test apps/tui/tests/flows.test.ts",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:tui": "turbo run dev -F tui --",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@browser-automation-cli/config": "workspace:*",
		"@types/node": "^22.20.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"turbo": "^2.10.7",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	},
	"packageManager": "bun@1.3.12"
}
